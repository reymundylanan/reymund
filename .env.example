# GlowSync settings. Copy this file to .env.local (or add these in your
# hosting dashboard) and fill in the values. Never commit real values.

# ── Supabase (required) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: full database access. Keep it secret.
SUPABASE_SECRET_KEY=

# ── Site ──
# The live address, e.g. https://example.com (used in emails and Messenger links).
NEXT_PUBLIC_SITE_URL=
# Set automatically on Vercel; leave empty elsewhere.
# VERCEL_PROJECT_PRODUCTION_URL=

# ── AI assistant and review checks (Google Gemini) ──
GEMINI_API_KEY=
# Shared secret for the review-evaluation job.
REVIEW_EVAL_SECRET=

# ── Email ──
# The spa Gmail sends to every client (use a Gmail "app password").
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional fallback when Gmail isn't set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Facebook Messenger (optional) ──
NEXT_PUBLIC_MESSENGER_PAGE_USERNAME=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_DISPATCH_SECRET=

# ── Scheduled jobs ──
# Protects the payment-reminder cron job.
CRON_SECRET=

# ── Browser push notifications (VAPID keys: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sign in with Google ──
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Optional extras ──
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
